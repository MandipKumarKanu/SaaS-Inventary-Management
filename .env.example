# ============================================
# Inventory SaaS — Environment Configuration
# Copy to backend/.env and fill in real values.
# ============================================

# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection for transactional inventory operations
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres
# (or HOST + PASSWORD; user defaults to postgres / postgres.<project-ref>)
# SUPABASE_DB_HOST=db.your-project.supabase.co
# SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_DB_USER=postgres

# ── App ──
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ── Platform admins (comma-separated emails, seeded at migration time) ──
PLATFORM_ADMIN_EMAILS=admin@example.com

# ── Stripe (Phase 0/3) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Plan tier → Stripe Price ID map (JSON)
STRIPE_PRICE_MAP={"starter":"price_...","business":"price_...","enterprise":"price_..."}

# ── IndexNow (Bing instant indexing) ──
INDEXNOW_KEY=

# ═══════════════════════════════════════════════════════════════
# DB-Driven Configuration (Phase 7b) — NO hardcoded business data.
# These JSON seeds are written INTO tables by run-migrations.ts;
# the DATABASE is the runtime source of truth afterwards.
# ═══════════════════════════════════════════════════════════════

# Subscription plans (JSON array → subscription_plans).
# limits use -1 for unlimited. prices are monthly/annual numbers.
PLAN_SEED=[{"name":"free","display_name":"Free","price_monthly":0,"price_annual":0,"limits":{"users":2,"products":100,"warehouses":1,"transactions_per_month":500,"storage_mb":100},"features":{"basic_reports":true,"csv_export":true,"forecasting":false,"api_access":false,"priority_support":false},"sort_order":1},{"name":"starter","display_name":"Starter","price_monthly":29,"price_annual":290,"limits":{"users":5,"products":1000,"warehouses":2,"transactions_per_month":5000,"storage_mb":1000},"features":{"basic_reports":true,"csv_export":true,"forecasting":false,"api_access":false,"priority_support":false},"sort_order":2},{"name":"business","display_name":"Business","price_monthly":79,"price_annual":790,"limits":{"users":25,"products":10000,"warehouses":10,"transactions_per_month":50000,"storage_mb":10000},"features":{"basic_reports":true,"csv_export":true,"forecasting":true,"api_access":true,"priority_support":true},"sort_order":3},{"name":"enterprise","display_name":"Enterprise","price_monthly":199,"price_annual":1990,"limits":{"users":-1,"products":-1,"warehouses":-1,"transactions_per_month":-1,"storage_mb":100000},"features":{"basic_reports":true,"csv_export":true,"forecasting":true,"api_access":true,"priority_support":true,"custom_integrations":true},"sort_order":4}]

# Role templates (JSON array → role_templates). EXACTLY ONE must have
# is_owner=true. Permissions must exist in the permissions catalog
# (migration 002) — seeding hard-fails on unknown codes.
ROLE_TEMPLATE_SEED=[{"name":"Owner","description":"Full workspace control","is_owner":true,"permissions":["products.view","products.create","products.update","products.archive","inventory.view","inventory.adjust","inventory.transfer","inventory.count","warehouses.view","warehouses.create","warehouses.update","warehouses.archive","purchases.view","purchases.create","purchases.approve","purchases.receive","sales.view","sales.create","sales.reserve","sales.fulfill","sales.cancel","transfers.view","transfers.create","transfers.approve","transfers.ship","transfers.receive","returns.view","returns.create","returns.approve","returns.inspect","returns.restock","reports.view","reports.export","team.view","team.invite","team.manage","roles.view","roles.manage","settings.view","settings.manage","billing.view","billing.manage"],"sort_order":1},{"name":"Admin","description":"All except billing management","permissions":["products.view","products.create","products.update","products.archive","inventory.view","inventory.adjust","inventory.transfer","inventory.count","warehouses.view","warehouses.create","warehouses.update","warehouses.archive","purchases.view","purchases.create","purchases.approve","purchases.receive","sales.view","sales.create","sales.reserve","sales.fulfill","sales.cancel","transfers.view","transfers.create","transfers.approve","transfers.ship","transfers.receive","returns.view","returns.create","returns.approve","returns.inspect","returns.restock","reports.view","reports.export","team.view","team.invite","team.manage","roles.view","roles.manage","settings.view","settings.manage","billing.view"],"sort_order":2},{"name":"Manager","description":"Operational management","permissions":["products.view","products.create","products.update","inventory.view","inventory.adjust","inventory.transfer","inventory.count","warehouses.view","warehouses.create","warehouses.update","purchases.view","purchases.create","purchases.approve","purchases.receive","sales.view","sales.create","sales.reserve","sales.fulfill","sales.cancel","transfers.view","transfers.create","transfers.approve","transfers.ship","transfers.receive","returns.view","returns.create","returns.approve","returns.inspect","returns.restock","reports.view","reports.export","team.view","settings.view"],"sort_order":3},{"name":"Warehouse Staff","description":"Floor operations","permissions":["products.view","inventory.view","inventory.adjust","inventory.transfer","inventory.count","warehouses.view","purchases.view","purchases.receive","transfers.view","transfers.create","transfers.ship","transfers.receive","returns.view","returns.inspect","returns.restock"],"sort_order":4},{"name":"Purchasing Staff","description":"Procurement","permissions":["products.view","inventory.view","warehouses.view","purchases.view","purchases.create","purchases.receive","reports.view"],"sort_order":5},{"name":"Sales Staff","description":"Order management","permissions":["products.view","inventory.view","warehouses.view","sales.view","sales.create","sales.reserve","sales.fulfill","returns.view","returns.create","reports.view"],"sort_order":6}]

# Operational defaults (→ config_defaults table; workspace settings override)
DEFAULT_PLAN_TIER=free
TRIAL_DAYS=14
COUNT_APPROVAL_THRESHOLD_PCT=100
EXPIRY_ALERT_DAYS=[30,14,7,1]
