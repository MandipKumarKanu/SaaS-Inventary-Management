# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3000
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Platform Admin
PLATFORM_ADMIN_EMAILS=admin@example.com

# Bing IndexNow (https://www.bing.com/webmasters/help/indexnow) — optional but
# strongly recommended for "Discovered but not crawled" recovery.
# 1) Generate: openssl rand -hex 16
# 2) Host key file at <APP_URL>/<KEY>.txt (frontend public/<KEY>.txt)
# 3) POST public URL changes to /api/v1/seo/indexnow/submit
INDEXNOW_KEY=
